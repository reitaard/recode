{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"outDir": "./dist",
		"paths": {
			"@reitaard/recode-ai": ["../ai/dist/index.d.ts"],
			"@reitaard/recode-ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
			"@reitaard/recode-telemetry": ["../telemetry/dist/index.d.ts"],
			"@reitaard/recode-telemetry/*": ["../telemetry/dist/*.d.ts", "../telemetry/dist/testing/*.d.ts"]
		},
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist", "**/*.d.ts", "src/**/*.d.ts"]
}
