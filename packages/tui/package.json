{
	"name": "@reitaard/recode-tui",
	"version": "0.1.0",
	"description": "Terminal user-interface library with differential rendering for Recode",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "node --test --test-reporter=dot --test-reporter-destination=stdout test/*.test.ts",
		"prepublishOnly": "node -e \"throw new Error('Publication is disabled until standalone certification completes')\""
	},
	"files": [
		"dist/**/*",
		"README.md"
	],
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"author": "Recode contributors; derived from work by Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/reitaard/recode.git",
		"directory": "packages/tui"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"get-east-asian-width": "1.6.0",
		"marked": "18.0.5"
	},
	"devDependencies": {
		"@xterm/headless": "5.5.0",
		"chalk": "5.6.2",
		"typescript": "5.9.3",
		"shx": "0.4.0",
		"@types/node": "24.12.4"
	},
	"private": true,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	}
}
