{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"rewriteRelativeImportExtensions": true,
		"paths": {
			"@reitaard/recode-coding-agent": ["../coding-agent/dist/index.d.ts"],
			"@reitaard/recode-coding-agent/*": ["../coding-agent/dist/*.d.ts"],
			"@reitaard/recode-tui": ["../tui/dist/index.d.ts"],
			"@reitaard/recode-tui/*": ["../tui/dist/*.d.ts"]
		},
		"outDir": "./dist",
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist", "**/*.d.ts", "src/**/*.d.ts"]
}
