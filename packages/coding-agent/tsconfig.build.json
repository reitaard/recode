{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"outDir": "./dist",
		"paths": {
			"@reitaard/recode-agent-core": ["../agent/dist/index.d.ts"],
			"@reitaard/recode-agent-core/*": ["../agent/dist/*.d.ts"],
			"@reitaard/recode-ai": ["../ai/dist/index.d.ts"],
			"@reitaard/recode-ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
			"@reitaard/recode-tui": ["../tui/dist/index.d.ts"],
			"@reitaard/recode-tui/*": ["../tui/dist/*.d.ts", "../tui/dist/components/*.d.ts"]
		},
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": [
		"node_modules",
		"dist",
		"src/cli/experimental/**",
		"src/client/**",
		"src/server/**"
	]
}
